NODE_ENV=development
PORT=3335
HOST=0.0.0.0
APP_PUBLIC_URL=http://localhost:3335
PORTAL_PUBLIC_URL=http://localhost:5173
# Exemplo generico para publicacao externa sem HTTPS:
# APP_PUBLIC_URL=http://api.empresa.com.br:8080
# PORTAL_PUBLIC_URL=http://api.empresa.com.br:8080

# Banco interno do produto: PostgreSQL
PRODUCT_DATABASE_PROVIDER=postgres
DATABASE_URL=postgres://postgres:controls@localhost:5432/control_s_api_hub

# Segurança
JWT_SECRET=troque-este-segredo-em-producao
TOKEN_HASH_PEPPER=troque-este-pepper-em-producao
CREDENTIALS_MASTER_KEY=defina-uma-chave-base64-de-32-bytes
INTEGRATION_TIMEOUT_MS=30000
GMOBII_DOCUMENTATION_PATH=C:\Documentos\Documentacao GMOBII 1.2.pdf
GMOBII_CANCELLATION_DOCUMENTATION_PATH=C:\Documentos\Documentacao GMOBII - Cancelamento.pdf
GMOBII_APPROVAL_DOCUMENTATION_PATH=C:\Documentos\Documentacao GMOBII - Aprovacao.pdf
GMOBII_VIDEOS_PATH=C:\Control S API Hub\videos\GMOBii
SUPER_ADMIN_EMAIL=admin@empresa.com.br
SUPER_ADMIN_PASSWORD=troque-esta-senha-em-producao

# Drivers de bancos externos habilitados pela plataforma
ENABLE_ORACLE=true
ENABLE_SQLSERVER=true
ENABLE_FIREBIRD=true
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=notificacao@controlsone.com.br
